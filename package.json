{
  "name": "n100n",
  "version": "1.1.0",
  "description": "Engine automasi lokal n8n-like tanpa dependency (Node.js built-in)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "mock-kra": "node examples/mock-kra.js",
    "smoke": "node examples/smoke-alur.js"
  },
  "keywords": ["n8n", "automation", "workflow", "zero-dependency", "kra"],
  "license": "MIT"
}

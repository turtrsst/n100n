# ---- dasar ----
# APP_PASSWORD & APP_API_TOKEN sebaiknya diganti dengan nilai acak panjang.
# Buat cepat: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_PORT=5679
APP_HOST=0.0.0.0
APP_PASSWORD=
APP_SECRET=
APP_API_TOKEN=
APP_MAX_PARALLEL=2
APP_SEED=1
# APP_CORS_ORIGIN=https://kra.local   # hanya perlu kalau browser KRA memanggil n100n langsung

# ---- folder vault KRA (node file) ----
VAULT_DIR=\\100.76.172.67\c$\vault

# ---- integrasi kantor-rama-ai (KRA) ----
KRA_BASE_URL=http://localhost:8000
KRA_API_KEY=
# URL tujuan tugas (default: {KRA_BASE_URL}/api/tugas)
# KRA_TUGAS_URL=http://127.0.0.1:8080/api/index.php?action=flow-tugas
# KRA_TUGAS_LIST_URL=http://127.0.0.1:8080/api/index.php?action=flow-tugas

# ---- contoh alur (workflows/contoh-alur-polling.json) ----
# driver sheet: csv (tanpa internet) atau google
CONTOH_SHEET_DRIVER=csv
CONTOH_SUMBER_CSV=files/sumber.csv
CONTOH_HASIL_CSV=files/hasil.csv
CONTOH_SUMBER_SHEET_ID=
CONTOH_HASIL_SHEET_ID=
CONTOH_SUMBER_RANGE=Sumber!A1:C
CONTOH_HASIL_RANGE=Hasil!A1:E
CONTOH_AGEN=agen-1
CONTOH_GAYA=
CONTOH_MAKS_PUTARAN=5

# service account Google (path file atau isi JSON satu baris) bila CONTOH_SHEET_DRIVER=google
GOOGLE_SA_JSON=
# GOOGLE_SA_JSON=C:\xampp\htdocs\n100n\secrets\service-account.json

# ---- notifikasi (node telegram) ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
